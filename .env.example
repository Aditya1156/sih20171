# LLM Provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# API keys (provide only the one matching LLM_PROVIDER)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend authentication
BACKEND_API_TOKEN=

# CORS
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Logging (never log page content)
LOG_LEVEL=info
